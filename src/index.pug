//- 液态玻璃按钮 · 静态页面模板（语言文案来自 i18n/<code>.yml）
doctype html
html(lang=code, dir=dir)
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= t.title
    meta(name="description", content=t.lead)
    meta(property="og:title", content=t.title)
    meta(property="og:description", content=t.lead)
    meta(property="og:type", content="website")
    style!= css
  body
    header.topbar
      .wrap
        //- 品牌名直接用该语言的标题（各语言 i18n 的 title），避免再维护一份
        span.brand= t.title
        nav
          //- 顶栏两个按钮共用 webc 的 .BtnC；只有图标不同（Ico / Ico.github）
          a.BtnC(href="https://github.com/x-at-01/liquid-glass-button", aria-label="GitHub", title="GitHub")
            i.Ico.github
          //- 语言按钮：结构取自 webc 的 I18n 组件（.BtnC.lang > .Ico）
          button.BtnC.lang#langBtn(type="button", aria-label=t.lang_aria, aria-haspopup="dialog")
            i.Ico

    header.hero
      .wrap
        h1= t.title
        p.lead= t.lead
        section.stage
          .cta
            button.btn.btn--blue(type="button")
              img.dl(src="../assets/icons/download.svg", alt="")
              span= t.btn_download
            button.btn.btn--black(type="button")
              img.ap(src="../assets/icons/apple.svg", alt="")
              span= t.btn_appstore
          p.hint= t.stage_hint

    //- 素材包：开头独立区块，按钮本身就是示范
    section.pack-sec
      .wrap
        .pack
          .pack-head
            h2= t.pack_h
            p= t.pack_p
            ul.pack-files
              li demo.html
              li style.css
              li app.js
              li glass-filters.svg
              li icons/
          a.btn.btn--blue(href="../liquid-glass-button.tar.xz", download)
            img.dl(src="../assets/icons/download.svg", alt="")
            span= t.link_pack

    section.section
      .wrap
        .section-head
          h2= t.sec_width_h
          p.sub= t.sec_width_p
        .card
          .measure-row
            .measure
              button.btn.btn--black(type="button")
                span= t.w_short
              span.w
            .measure
              button.btn.btn--black(type="button")
                img.ap(src="../assets/icons/apple.svg", alt="")
                span= t.w_appstore
              span.w
            .measure
              button.btn.btn--blue(type="button")
                img.dl(src="../assets/icons/download.svg", alt="")
                span= t.w_long
              span.w
          p.hint= t.light_hint

    //- SVG 设计原理：位移图 → 三次位移（色散）→ 边缘遮罩 → 背景模糊链
    section.section
      .wrap
        .section-head
          h2= t.sec_svg_h
          p.sub= t.sec_svg_p
        .principles
          .principle
            span.n 01
            p= t.svg_p1
          .principle
            span.n 02
            p= t.svg_p2
          .principle
            span.n 03
            p= t.svg_p3
        pre
          code.
            /* 1) 按按钮实际尺寸生成位移图（app.js → canvas） */
            R = 128 + x 位移 · G = 128 + y 位移 · B = 边缘强度（中心 0 → 贴边 255）

            /* 2) 同一张图做三次位移，scale 略有差异，分离 R/G/B 后 screen 叠加 → 色散 */
            feDisplacementMap  in2="map"  scale="s·1.00"  → feColorMatrix → R
            feDisplacementMap  in2="map"  scale="s·0.92"  → feColorMatrix → G
            feDisplacementMap  in2="map"  scale="s·0.84"  → feColorMatrix → B
            feBlend mode="screen"

            /* 3) 用位移图的 B 通道做遮罩：只有边缘参与折射，中心保持清晰 */
            feComponentTransfer → edgeMask
            feComposite in="edge" in2="center" operator="over"

            /* 4) 背景模糊链（SVG 滤镜只负责折射，磨砂交给 blur） */
            backdrop-filter: url(#glass-N) blur(6px) contrast(1.15) saturate(170%)

    //- 用法：一个元素的完整配方
    section.section
      .wrap
        .section-head
          h2= t.sec_usage_h
          p.sub= t.sec_usage_p
        pre
          code.
            .btn {
              display: inline-flex; align-items: center; gap: 9px;
              height: 56px; padding: 0 28px;            /* 宽度由文字决定 */
              border: 0; border-radius: 980px;
              background:                               /* 扁平：几乎平色，只有极轻的顶缘受光 */
                radial-gradient(125% 112% at 50% -26%, #ffffff1f, #ffffff08 30%, transparent 55%),
                linear-gradient(180deg, transparent 66%, #0000001a),
                var(--tint);                          /* 黑：rgba(12,12,14,.82) */
              box-shadow: inset 0 1px 1px #ffffff2e,  /* 发丝级棱边 */
                          inset 0 -1px 1px #00000033,
                          inset 0 -10px 14px -12px #00000038;
            }
            .btn--blue {                              /* 蓝：竖向明度差约 6%，白字对比约 4.4:1 */
              background: linear-gradient(180deg, #125fd8 0%, #0746a4 100%);
              backdrop-filter: url(#glass-1) blur(6px) contrast(1.15) saturate(170%);
            }
            /* 天光：::after 径向柔光 + mix-blend-mode:screen（负 z-index，压在底色上、文字下） */
            /* 折射滤镜：./glass-filters.svg 是模板，app.js 按按钮尺寸 clone 出常态 / hover / active 三份 */

    section.section.section--tint
      .wrap
        h2= t.sec_spec_h
        .specs
          .spec
            h3= t.spec_font_h
            p= t.spec_font_p
          .spec
            h3= t.spec_btn_h
            p= t.spec_btn_p
          .spec
            h3= t.spec_icon_h
            p= t.spec_icon_p

    footer
      .wrap
        .foot-links
          a(href="https://github.com/x-at-01/liquid-glass-button")= t.link_repo
          a(href="https://developer.apple.com/design/human-interface-guidelines/materials")= t.link_hig
        p= t.footer_2

    //- SVG 滤镜（构建时从 assets/glass-filters.svg 内联；运行时按按钮尺寸 clone）
    svg.glass-defs(width="0", height="0", aria-hidden="true")!= filterSvg
    style#glass-styles
    script.
      window.__GLASS__ = !{glass};
    script!= appJs

//- 液态玻璃按钮 · 静态页面模板（语言文案来自 i18n/<code>.yml）
doctype html
html(lang=code, dir=dir)
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= t.title
    meta(name="description", content=t.lead)
    meta(property="og:title", content=t.title)
    meta(property="og:description", content=t.lead)
    meta(property="og:type", content="website")
    style!= css
  body
    header.topbar
      .wrap
        span.brand
          i
          | Liquid Glass Button
        nav
          a(href="https://github.com/x-at-01/liquid-glass-button") GitHub
          button.lang-btn#langBtn(type="button", aria-label=t.lang_aria, aria-haspopup="dialog")
            img(src="../assets/icons/globe.svg", alt="", width="18", height="18")

    header.hero
      .head
        p.eyebrow= t.eyebrow
        h1= t.title
        p.lead= t.lead
      section.stage
        .cta
          button.btn.btn--blue(type="button")
            img(src="../assets/icons/download.svg", alt="", width="20", height="20")
            span= t.btn_download
          button.btn.btn--black(type="button")
            img(src="../assets/icons/apple.svg", alt="", width="20", height="20")
            span= t.btn_appstore
        p.hint= t.stage_hint

    section.section
      .wrap
        .section-head
          h2= t.sec_width_h
          p.sub= t.sec_width_p
        .card
          .measure-row
            .measure
              button.btn.btn--black(type="button")
                span= t.w_short
              span.w
            .measure
              button.btn.btn--black(type="button")
                img(src="../assets/icons/apple.svg", alt="", width="20", height="20")
                span= t.w_appstore
              span.w
            .measure
              button.btn.btn--blue(type="button")
                img(src="../assets/icons/download.svg", alt="", width="20", height="20")
                span= t.w_long
              span.w
          p.hint= t.light_hint

    section.section.section--tint
      .wrap
        .section-head
          h2= t.sec_assets_h
          p.sub= t.sec_assets_p
        .pieces
          figure
            .shot
              img(src="../assets/glass/black-sheet.webp", alt="")
            figcaption
              b= t.cap_sheet
              |  · 352×224 · 4×
          figure
            .shot
              img(src="../assets/glass/black-left.webp", alt="")
            figcaption
              b= t.cap_left
              |  · 112×224
          figure
            .shot
              img(src="../assets/glass/black-mid.webp", alt="")
            figcaption
              b= t.cap_mid
              |  · 128×224
          figure
            .shot
              img(src="../assets/glass/black-right.webp", alt="")
            figcaption
              b= t.cap_right
              |  · 112×224
        .tile-wrap
          .checker
            .tile-strip#tileStrip
          p.cap= t.cap_tile

    section.section
      .wrap
        .section-head
          h2= t.sec_usage_h
          p.sub= t.sec_usage_p
        pre
          code.
            .btn {
              display: inline-flex; align-items: center; gap: 9px;
              height: 56px; width: auto;              /* width comes from the label */
              border: 0 solid transparent;
              border-left-width: 28px; border-right-width: 28px;
              border-image: url(./assets/glass/black-sheet.webp) 0 112 0 112 fill stretch;
              border-radius: 980px; color: #fff;
              backdrop-filter: url(#glass-1) blur(6px) contrast(1.15) saturate(170%);
            }
            /* displacement map + filter template: ./assets/glass-filters.svg */

    section.section.section--tint
      .wrap
        h2= t.sec_spec_h
        .specs
          .spec
            h3= t.spec_font_h
            p= t.spec_font_p
          .spec
            h3= t.spec_btn_h
            p= t.spec_btn_p
          .spec
            h3= t.spec_asset_h
            p= t.spec_asset_p
          .spec
            h3= t.spec_icon_h
            p= t.spec_icon_p

    footer
      .wrap
        .foot-links
          a(href="https://github.com/x-at-01/liquid-glass-button")= t.link_repo
          a(href="https://developer.apple.com/design/human-interface-guidelines/materials")= t.link_hig
          a(href="https://huggingface.co/Qwen/Qwen-Image-2.1")= t.link_model
        p= t.footer_1
        p= t.footer_2

    dialog.lang#langDialog
      h2= t.lang_choose
      ul.lang-list#langList
        each l in langs
          li
            button(type="button", data-idx=l.idx, aria-current=(l.code === code ? "true" : "false"))
              span= l.name
              span.code
                | #{l.code}
                if !l.own
                  i.fb en

    //- SVG 滤镜（构建时从 assets/glass-filters.svg 内联；运行时按按钮尺寸 clone）
    svg.glass-defs(width="0", height="0", aria-hidden="true")!= filterSvg
    style#glass-styles
    script.
      window.__GLASS__ = !{JSON.stringify({ code: code, idx: langs.findIndex(function (l) { return l.code === code; }), lang_li: langs.map(function (l) { return l.code; }) })};
    script!= appJs

//- 液态玻璃按钮 · 静态页面模板（语言文案来自 i18n/<code>.yml）
doctype html
html(lang=code, dir=dir)
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= t.title
    meta(name="description", content=t.lead)
    meta(property="og:title", content=t.title)
    meta(property="og:description", content=t.lead)
    meta(property="og:type", content="website")
    style!= css
  body
    header.topbar
      .wrap
        //- 品牌名直接用该语言的标题（各语言 i18n 的 title），避免再维护一份
        span.brand= t.title
        nav
          //- 顶栏两个按钮共用 webc 的 .BtnC；只有图标不同（Ico / Ico.github）
          a.BtnC(href="https://github.com/x-at-01/liquid-glass-button", aria-label="GitHub", title="GitHub")
            i.Ico.github
          //- 语言按钮：结构取自 webc 的 I18n 组件（.BtnC.lang > .Ico）
          button.BtnC.lang#langBtn(type="button", aria-label=t.lang_aria, aria-haspopup="dialog")
            i.Ico

    header.hero
      .wrap
        h1= t.title
        p.lead= t.lead
        section.stage
          .cta
            button.btn.btn--blue(type="button")
              img.dl(src="../assets/icons/download.svg", alt="")
              span= t.btn_download
            button.btn.btn--black(type="button")
              img.ap(src="../assets/icons/apple.svg", alt="")
              span= t.btn_appstore
          p.hint= t.stage_hint

    //- 素材包：开头独立区块，按钮本身就是示范
    section.pack-sec
      .wrap
        .pack
          .pack-head
            h2= t.pack_h
            p= t.pack_p
            ul.pack-files
              li demo.html
              li button.css
              li page.css
              li icons/
          a.btn.btn--blue(href="../liquid-glass-button.tar.xz", download)
            img.dl(src="../assets/icons/download.svg", alt="")
            span= t.link_pack

    section.section
      .wrap
        .section-head
          h2= t.sec_width_h
          p.sub= t.sec_width_p
        .card
          .measure-row
            .measure
              button.btn.btn--black(type="button")
                span= t.w_short
              span.w
            .measure
              button.btn.btn--black(type="button")
                img.ap(src="../assets/icons/apple.svg", alt="")
                span= t.w_appstore
              span.w
            .measure
              button.btn.btn--blue(type="button")
                img.dl(src="../assets/icons/download.svg", alt="")
                span= t.w_long
              span.w
          p.hint= t.light_hint

    //- 用法：一个元素的完整配方
    section.section
      .wrap
        .section-head
          h2= t.sec_usage_h
        pre
          code.
            .btn {
              display: inline-flex; align-items: center; gap: 9px;
              height: 56px; padding: 0 28px;            /* width comes from the label */
              border: 0; border-radius: 980px;
              background:                               /* near-flat tint + a very light top light */
                radial-gradient(125% 112% at 50% -26%, #ffffff1f, #ffffff08 30%, transparent 55%),
                linear-gradient(180deg, transparent 66%, #0000001a),
                var(--tint);                          /* black: rgba(12,12,14,.82) */
              box-shadow: inset 0 1px 1px #ffffff2e,  /* hairline rim */
                          inset 0 -1px 1px #00000033,
                          inset 0 -10px 14px -12px #00000038;
            }
            .btn--blue {                              /* azure: ~6% vertical gradient, ~4.4:1 with white */
              background: linear-gradient(180deg, #125fd8 0%, #0746a4 100%);
              backdrop-filter: blur(20px) saturate(180%);   /* frosted, pure CSS */
            }
            /* hover: faint inset ring + one specular band that sweeps across (clipped by the pill) */
            /* pressed: deeper inset ring, slight scale-down, engraved label shadow */

    section.section.section--tint
      .wrap
        h2= t.sec_spec_h
        .specs
          .spec
            h3= t.spec_font_h
            p= t.spec_font_p
          .spec
            h3= t.spec_btn_h
            p= t.spec_btn_p
          .spec
            h3= t.spec_icon_h
            p= t.spec_icon_p

    footer
      .wrap
        .foot-links
          a(href="https://github.com/x-at-01/liquid-glass-button")= t.link_repo
          a(href="https://developer.apple.com/design/human-interface-guidelines/materials")= t.link_hig
        p= t.footer_2

    script.
      window.__GLASS__ = !{glass};
    script!= siteJs

//- 液态玻璃按钮 · 静态页面模板（语言文案来自 i18n/<code>.yml）
doctype html
html(lang=code, dir=dir)
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= t.title
    meta(name="description", content=t.lead)
    meta(property="og:title", content=t.title)
    meta(property="og:description", content=t.lead)
    meta(property="og:type", content="website")
    style!= css
  body
    header.topbar
      .wrap
        //- 品牌名直接用该语言的标题（各语言 i18n 的 title），避免再维护一份
        span.brand
          i
          = t.title
        nav
          //- 顶栏两个按钮共用 webc 的 .BtnC；只有图标不同（Ico / Ico.github）
          a.BtnC(href="https://github.com/x-at-01/liquid-glass-button", aria-label="GitHub", title="GitHub")
            i.Ico.github
          //- 语言按钮：结构取自 webc 的 I18n 组件（.BtnC.lang > .Ico）
          button.BtnC.lang#langBtn(type="button", aria-label=t.lang_aria, aria-haspopup="dialog")
            i.Ico

    header.hero
      .head
        h1= t.title
        p.lead= t.lead
      section.stage
        .cta
          button.btn.btn--blue(type="button")
            img.dl(src="../assets/icons/download.svg", alt="")
            span= t.btn_download
          button.btn.btn--black(type="button")
            img.ap(src="../assets/icons/apple.svg", alt="")
            span= t.btn_appstore
        p.hint= t.stage_hint

    section.section
      .wrap
        .section-head
          h2= t.sec_width_h
          p.sub= t.sec_width_p
        .card
          .measure-row
            .measure
              button.btn.btn--black(type="button")
                span= t.w_short
              span.w
            .measure
              button.btn.btn--black(type="button")
                img.ap(src="../assets/icons/apple.svg", alt="")
                span= t.w_appstore
              span.w
            .measure
              button.btn.btn--blue(type="button")
                img.dl(src="../assets/icons/download.svg", alt="")
                span= t.w_long
              span.w
          p.hint= t.light_hint

    section.section
      .wrap
        .section-head
          h2= t.sec_svg_h
          p.sub= t.sec_svg_p
        .card
          .measure-row
            .measure
              button.btn.svg.btn--black(type="button")
                span= t.w_short
              span.w
            .measure
              button.btn.svg.btn--black(type="button")
                img.ap(src="../assets/icons/apple.svg", alt="")
                span= t.w_appstore
              span.w
            .measure
              button.btn.svg.btn--blue(type="button")
                img.dl(src="../assets/icons/download.svg", alt="")
                span= t.w_long
              span.w
          p.hint= t.light_hint
        pre
          code.
            .btn.svg {
              border: 1px solid #ffffff2e;         /* 半透明白描边 */
              border-radius: 980px; padding: 0 27px;
              background: var(--tint);
              box-shadow: inset 0 1px 1px #ffffff8c,   /* 上缘最亮（≈2× 侧缘）才是 rim */
                          inset 0 -1px 1px #ffffff4d,
                          inset 1px 0 1px #ffffff33, inset -1px 0 1px #ffffff33,
                          inset 0 -12px 16px -12px #ffffff1c,  /* 底缘内侧回光 */
                          0 10px 22px -8px #00000052, 0 2px 6px #00000024;
              backdrop-filter: url(#glass-1) blur(6px) saturate(170%); /* 同一个 SVG 折射滤镜 */
            }
            /* 天光：::after 135° 渐变 + mix-blend-mode:screen，负 z-index 压在 tint 上、文字之下 */

    section.section.section--tint
      .wrap
        .section-head
          h2= t.sec_assets_h
          p.sub= t.sec_assets_p
        .pieces
          figure
            .shot
              img(src="../assets/glass/black-sheet.webp", alt="")
            figcaption
              b= t.cap_sheet
              |  · 352×224 · 4×
          figure
            .shot
              img(src="../assets/glass/black-left.webp", alt="")
            figcaption
              b= t.cap_left
              |  · 112×224
          figure
            .shot
              img(src="../assets/glass/black-mid.webp", alt="")
            figcaption
              b= t.cap_mid
              |  · 128×224
          figure
            .shot
              img(src="../assets/glass/black-right.webp", alt="")
            figcaption
              b= t.cap_right
              |  · 112×224
        .tile-wrap
          .checker
            .tile-strip#tileStrip
          p.cap= t.cap_tile

    section.section
      .wrap
        .section-head
          h2= t.sec_usage_h
          p.sub= t.sec_usage_p
        pre
          code.
            .btn {
              display: inline-flex; align-items: center; gap: 9px;
              height: 56px; width: auto;              /* width comes from the label */
              border: 0 solid transparent;
              border-left-width: 28px; border-right-width: 28px;
              border-image: url(./assets/glass/black-sheet.webp) 0 112 0 112 fill stretch;
              border-radius: 980px; color: #fff;
              backdrop-filter: url(#glass-1) blur(6px) contrast(1.15) saturate(170%);
            }
            /* displacement map + filter template: ./assets/glass-filters.svg */

    section.section.section--tint
      .wrap
        h2= t.sec_spec_h
        .specs
          .spec
            h3= t.spec_font_h
            p= t.spec_font_p
          .spec
            h3= t.spec_btn_h
            p= t.spec_btn_p
          .spec
            h3= t.spec_asset_h
            p= t.spec_asset_p
          .spec
            h3= t.spec_icon_h
            p= t.spec_icon_p

    footer
      .wrap
        .foot-links
          a(href="https://github.com/x-at-01/liquid-glass-button")= t.link_repo
          a(href="https://developer.apple.com/design/human-interface-guidelines/materials")= t.link_hig
          a(href="https://huggingface.co/Qwen/Qwen-Image-2.1")= t.link_model
        p= t.footer_1
        p= t.footer_2

    //- SVG 滤镜（构建时从 assets/glass-filters.svg 内联；运行时按按钮尺寸 clone）
    svg.glass-defs(width="0", height="0", aria-hidden="true")!= filterSvg
    style#glass-styles
    script.
      window.__GLASS__ = !{glass};
    script!= appJs
